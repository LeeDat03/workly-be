# =========== Common ================
NODE_ENV=production

JWT_SECRET=change-this-to-a-strong-secret-key-min-32-characters
JWT_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:3000

RABBITMQ_URL=amqp://username:password@your-rabbitmq-url:5672
REDIS_URI=redis://your-redis-url:6379

# =========== USER ================
NEO4J_URI=bolt://your-neo4j-url:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587/ 456
MAIL_USER=user@gmail.com
MAIL_PASS=xxxxxxxxxxxx
MAIL_FROM_EMAIL=user@gmail.com
MAIL_FROM_NAME="Workly"

# =========== COMPANY ================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/workly?retryWrites=true&w=majority
MONGODB_DB_NAME=workly-be

ELASTICSEARCH_CLOUD_ID=your-cloud-id
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
