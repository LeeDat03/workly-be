# =========== Common ================
NODE_ENV=production

JWT_SECRET=change-this-to-a-strong-secret-key-min-32-characters
JWT_EXPIRES_IN=7d

RABBITMQ_URL=amqp://username:password@your-rabbitmq-url:5672
REDIS_URI=redis://your-redis-url:6379

# =========== USER ================
NEO4J_URI=bolt://your-neo4j-url:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@workly.com

# =========== COMPANY ================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/workly?retryWrites=true&w=majority
MONGODB_DB_NAME=workly-be

ELASTICSEARCH_CLOUD_ID=your-cloud-id
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
